VITE_API_BASE_URL=http://localhost:5000/api/v1

# The NICeMail Front Office address, shown in the DEV sign-in list so the
# account can be selected without typing it. Optional, and an address rather
# than a credential: that account signs in with a password like any other, and
# POST /auth/dev-login refuses it outright because its session can make the
# browser agent send from a live .gov.in mailbox. Leave blank to hide the entry.
# Mirror of the backend's NIC_EMAIL; the dev sign-in list is stripped from a
# production build.
VITE_NIC_FRONT_OFFICE_EMAIL=
