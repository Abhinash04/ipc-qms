# ─────────────────────────────────────────────────────────────────────────────
# Copy to backend/.env and fill in. `.env` is gitignored; keep it that way.
#
# Every variable the backend reads is listed here, and nothing here is unread —
# a name that appears in one and not the other is a bug in whichever changed
# last. The boot-refusal table at the bottom says which combinations the server
# will not start with.
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=mongodb://127.0.0.1:27017/query_management_system
JWT_SECRET=change-me-to-at-least-32-characters-long

# ── ENV_FILE — an overlay, and NOT settable from this file ────────────────────
# `ENV_FILE=.env.e2e npm start` loads that file FIRST and then `.env` for
# whatever it did not name, which is how the end-to-end suite gets its own
# database and mail settings without touching a developer's `.env`.
#
# It has to come from the environment, not from a `.env` line: config/env.js
# reads it before the first dotenv.config(), so a line here would never be seen.
#
# The trap worth knowing: dotenv does not overwrite a variable that is already
# set, so the overlay wins on every key it declares — and INHERITS every key it
# omits. An overlay that leaves out NIC_EMAIL runs against the developer's real
# mailbox. `.env.e2e` therefore pins the mail variables to empty values rather
# than omitting them.

# ── Sign-in credentials ──────────────────────────────────────────────────────
# Each account has its OWN password. There used to be one shared secret here
# that opened every account: login compared the submitted password against a
# single hash that did not depend on which account the address named, so anyone
# holding any account could sign in as SUPER_ADMIN with their own password.
#
# Two sources, in order of preference, per account:
#
#   1. QMS_PASSWORDS_FILE — a path to a JSON file OUTSIDE the repository:
#        { "USR-0002": "...", "USR-0003": "...", ... }
#      This is the production form, because config then stores a path rather
#      than a set of secrets. Keep it 0600.
#   2. QMS_PASSWORD_<USER_ID> — the value itself, e.g. QMS_PASSWORD_USR_0008.
#      Simpler for development; the secret then lives in backend/.env, which is
#      gitignored. The user ids are listed in src/constants/users.js.
#
# The server refuses to start if any account has neither, naming the account and
# the variable that would supply it. That is deliberate: a missing credential
# should be a named boot failure, not a person who cannot sign in and is told
# only "Invalid email or password".
#
# USR-0014 — the NICeMail Front Office — exists only when NIC_BROWSER_MAILBOX is
# true, and needs a credential like any other account when it does.
QMS_PASSWORDS_FILE=

# The legacy one-secret-opens-everything mode. Read carefully: the DEFAULT is
# not "off".
#
#   "true"  → on. Any account with no credential of its own falls back to
#             QMS_SEED_PASSWORD — one secret opening every account, SUPER_ADMIN
#             included. QMS_SEED_PASSWORD then becomes required.
#   "false" → off, always.
#   unset   → ON outside production whenever QMS_SEED_PASSWORD is non-empty,
#             and off in production. See services/auth/credentials.js.
#
# It exists so an existing deployment does not lock itself out on upgrade. Set
# it to "false" as soon as per-account credentials are in place, and leave it
# there — an explicit "false" is the only value that cannot change meaning when
# something else in the environment changes.
QMS_ALLOW_SHARED_PASSWORD=false
QMS_SEED_PASSWORD=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=qms.session
SESSION_COOKIE_SAMESITE=lax

# ── Mail ─────────────────────────────────────────────────────────────────────
# There are two ways mail can leave this machine, and they are chosen
# differently.
#
# A case remembers the mailbox its enquiry ARRIVED in (`sourceMailbox`, set by
# the server at intake). A case that arrived through the NICeMail browser agent
# sends ALL THREE of its emails — the acknowledgement, the forward to the
# Officer-in-Charge and the final response — back out through that same
# signed-in browser session, whatever EMAIL_TRANSPORT says. See
# NIC_BROWSER_MAILBOX below.
#
# EMAIL_TRANSPORT governs every OTHER case:
#   mock = nothing leaves the machine. Records each send as delivered, which is
#          right for development and catastrophic in production — it would close
#          cases and tell inquirers they had been answered. Refused when
#          NODE_ENV=production.
#   nic  = NICeMail SMTP, the direct mail protocol (see the IMAP/SMTP block).
#          Also held to NIC_TEST_RECIPIENT until NIC_ALLOW_OUTBOUND=true.
EMAIL_TRANSPORT=mock

# Where incoming enquiries are read from. Independent of the browser agent,
# which adds a mailbox of its own alongside whatever this selects.
#   auto = MongoDB when connected, else in-memory. The local test mailbox.
#   nic  = poll the NICeMail mailbox over IMAP, read-only.
MAILBOX_SOURCE=auto

# ── Stakeholder identities ───────────────────────────────────────────────────
# Nothing here is secret, and none of it is a sign-in account — the directory in
# src/constants/users.js is that, and every address in it is unroutable on
# purpose. These are where mail actually goes.
#
# Leaving one blank falls back to an `@example.com` placeholder that cannot
# receive mail — deliberately, so a missing value fails visibly instead of
# quietly mailing whoever the default used to name. Production refuses to start
# on a blank or `@example.com` value for either of these.
#
# REQUIRED — the Front Office mailbox. Enquiries must be addressed to it to be
# picked up, and every outbound message on a non-NICeMail case is sent from it.
FRONT_OFFICE_NAME=
FRONT_OFFICE_EMAIL=

# REQUIRED — where the Front Officer forwards a validated case. A recipient
# address only; nothing authenticates or sends as this role.
OFFICER_IN_CHARGE_NAME=
OFFICER_IN_CHARGE_EMAIL=

# There is deliberately no INQUIRER_EMAIL. An inquirer is EXTERNAL: whoever sent
# the incoming mail. Their name and address are read off the message at intake
# and stored on the case, they hold no account here, and they authenticate to
# nothing.

# Shared mock mailbox address, used when no real stakeholder is configured.
IPC_QUERY_EMAIL=ipc-query-mock@example.com
IPC_ACK_FROM_EMAIL=arnd-ipc-mock@example.com
IPC_ACK_FROM_NAME=AR&D Division

# ── NICeMail — mechanism 1 of 2: IMAP/SMTP ───────────────────────────────────
# The direct mail-protocol integration. These variables power three things:
#   - EMAIL_TRANSPORT=nic and MAILBOX_SOURCE=nic
#   - `npm run nic:verify` and `npm run nic:preflight`
#   - POST /api/v1/nic/{read,send}
#
# They have NOTHING to do with the NICeMail browser agent, which is mechanism 2
# and is configured in the NIC_CDP_* / NIC_WEBMAIL_* / NIC_BROWSER_* block
# below. The two never share a credential and never share a code path.
#
# NIC_EMAIL is the one variable to change to move to the production mailbox
# (lab.ipc@gov.in). The address is not hardcoded anywhere in the source — it is
# read through config/nicConfig.js and config/browserConfig.js and nowhere else.
# The value below is the development/test mailbox, not the production one.
NIC_EMAIL=contact.ecoclubs-edu@gov.in

# The application-specific password from webmail -> Security -> App Passwords.
# NOT the webmail login password: under MFA that is rejected for IMAP/SMTP by
# design. Prefer NIC_APP_PASSWORD_FILE (a path to a 0600 file OUTSIDE the
# repo); NIC_APP_PASSWORD is the development fallback. Never commit either.
NIC_APP_PASSWORD=
NIC_APP_PASSWORD_FILE=

# Endpoints confirmed reachable during Phase 0 (docs/NIC_EMAIL_PHASE0.md).
# imap/smtp.mail.gov.in did NOT answer from outside NICNET.
NIC_IMAP_HOST=imap.mgovcloud.in
NIC_IMAP_PORT=993
NIC_SMTP_HOST=smtp.mgovcloud.in
NIC_SMTP_PORT=465

# Implicit TLS on both ports. Set to the literal "false" only against a server
# that genuinely does not offer it — there is no certificate-validation escape
# hatch anywhere in this codebase, and there should not be one.
NIC_IMAP_SECURE=true
NIC_SMTP_SECURE=true

NIC_MAILBOX=INBOX
# The ONLY address send_nicemail will mail. Defaults to the mailbox itself, so
# the test never reaches a third party.
NIC_TEST_RECIPIENT=contact.ecoclubs-edu@gov.in
NIC_TIMEOUT_MS=20000

# ── The outbound interlock ───────────────────────────────────────────────────
# One switch, governing BOTH mechanisms. While it is anything but the exact
# string "true", every real send is confined to a single test recipient —
# NIC_TEST_RECIPIENT for SMTP, NIC_BROWSER_TEST_RECIPIENT for the agent — and a
# send to anyone else is refused before it is attempted, as a configuration
# error rather than a retryable failure.
#
# Selecting a real channel must not by itself be enough to start mailing the
# public from a .gov.in address. That is the whole point of a second key.
NIC_ALLOW_OUTBOUND=false

# One exception to the closed interlock, and only one: the forward to the
# Officer-in-Charge. "true" adds exactly OFFICER_IN_CHARGE_EMAIL to the allowed
# recipients for that email alone — re-derived server-side from the configured
# identity, never taken from a request.
#
# Without it, intake of a NICeMail case stops at the forward while the interlock
# is closed, because the Officer-in-Charge is not the test recipient. With it,
# the whole workflow runs end to end and nothing external is mailed.
#
# It is a RECIPIENT ALLOWANCE, not a second channel. Production refuses to start
# with it enabled against a blank or `@example.com` Officer-in-Charge address,
# which would otherwise add a permanently-allowed recipient to a closed guard.
NIC_ALLOW_INTERNAL_FORWARD=false

# ── NICeMail — mechanism 2 of 2: browser agent over CDP ──────────────────────
# Entirely separate from the IMAP/SMTP block above. The agent attaches to a
# Chrome session the OPERATOR has already opened and signed in to by hand; it
# never launches a browser, never navigates to a login page, never types a
# credential and never touches an OTP field. There is deliberately no password
# here, and there must never be one.
#
# Operator prerequisite (nothing the application can do for you):
#   chrome.exe --remote-debugging-port=9222 --user-data-dir=C:\qms-chrome
#   (a non-default user-data-dir is required on Chrome 136+), then sign in to
#   NICeMail in that window. Verify with `npm run nic:browser:discover`.
#
# Note the port must be FREE: another Chromium browser (Brave, Edge, a second
# Chrome profile) holding 9222 will answer the connection without speaking CDP.
NIC_CDP_ENDPOINT=http://localhost:9222
# Comma-separated. How a NICeMail tab is recognised among everything else open.
NIC_WEBMAIL_URL_PATTERNS=mail.gov.in,mgovcloud.in
NIC_WEBMAIL_TITLE_PATTERNS=mail,inbox,nic
# The URL the agent opens in its OWN background tab — never the operator's tab.
# On the workplace front door the mail UI is a cross-origin iframe with a
# debugging target of its own, which one session cannot drive; this address
# serves the same mailbox as a single top-level document, in the same profile
# and so with the same sign-in.
NIC_WEBMAIL_APP_URL=https://mail.mgovcloud.in/zm/
# The one address the agent may mail while the interlock is closed. Falls back
# to NIC_TEST_RECIPIENT, then to NIC_EMAIL — and a fallback to NIC_EMAIL is a
# "closed" interlock that quietly permits mail to the mailbox itself, so the
# server refuses to start when the agent is enabled and neither is set.
NIC_BROWSER_TEST_RECIPIENT=
NIC_BROWSER_TIMEOUT_MS=20000
# Where `npm run nic:browser:discover -- --json` writes its inspection reports.
# Relative paths resolve to the backend package root.
NIC_BROWSER_ARTIFACT_DIR=storage/nic-browser

# The NICeMail mailbox as a SECOND Front Office mailbox, read by the browser
# agent. "true" adds a Front Office account (USR-0014) that signs in as
# NIC_EMAIL and sees only that mailbox; the FRONT_OFFICE_* account keeps the
# MAILBOX_SOURCE mailbox. Requires MongoDB, and NIC_EMAIL must differ from
# FRONT_OFFICE_EMAIL. The IMAP settings above are NOT needed for this — the
# browser session carries the authentication.
#
# A case accepted from this mailbox sends all three of its emails through that
# session: the acknowledgement and the final response to the inquirer, and the
# forward to the Officer-in-Charge. Every one of them is held to the interlock
# above.
NIC_BROWSER_MAILBOX=false
# The display name of that second Front Office — on its sign-in account and on
# the From line of mail it sends (e.g. "Eco-Clubs Front Office"). A name, not
# an address. Empty falls back to "NICeMail Front Office".
NIC_FRONT_OFFICE_NAME=

# The inbox poll triggers a sync at most this often; each sync opens at most
# NIC_BROWSER_SYNC_MAX new messages.
NIC_BROWSER_SYNC_TTL_MS=30000
NIC_BROWSER_SYNC_MAX=20

# ── Pravah Gemma LLM ─────────────────────────────────────────────────────────
# Full endpoint URL for the Pravah Gemma model. Leave EMPTY to disable the
# LLM entirely — every AI call then returns its deterministic fallback. An
# explicitly empty value is honoured, not treated as unset.
GEMMA_API_URL=https://pravahai.aicte-india.org/llm/api/gemma
# Base request timeout, used as-is for a summary. An assignment recommendation
# gets 3x this and a draft 5x (gemmaService.js). Also the ceiling on how long
# intake can stall, because the forward to the Officer-in-Charge waits for a
# summary — the AI falls back on abort, so a dead endpoint delays the forward
# but never loses it.
GEMMA_TIMEOUT_MS=12000

# ── Attachments ──────────────────────────────────────────────────────────────
# Reading one requires a session AND membership of the case it belongs to:
# middleware/authorizeAttachmentAccess.js resolves the owning case and admits
# only a principal party to it, or a role that sees every case.
#
# Directory attachment bytes are written to. A relative value is resolved
# against the backend package root (not the working directory), so this lands in
# backend/storage/attachments however the server was started. Absolute paths are
# used as-is. Defaults to storage/attachments when unset.
ATTACHMENT_DIR=storage/attachments
ATTACHMENT_MAX_FILE_MB=10
# Below the ~25MB (encoded) cap a mail provider typically imposes: base64
# inflates payload size by about a third, and such caps are on the encoded
# message.
ATTACHMENT_MAX_TOTAL_MB=15
ATTACHMENT_MAX_FILES=10

# ─────────────────────────────────────────────────────────────────────────────
# What the server refuses to start with
#
# Both tables are enforced by config/env.js (validateEmailConfig) and
# config/authConfig.js (validateAuthConfig). The process exits 1 listing EVERY
# refusal it found, not the first.
#
# ALWAYS, whatever NODE_ENV says:
#
#   JWT_SECRET blank, or shorter than 32 characters.
#   SESSION_TTL_SECONDS not a positive number.
#   SESSION_COOKIE_SAMESITE not lax | strict | none.
#   Any account with no credential configured (named individually).
#   QMS_ALLOW_SHARED_PASSWORD=true with QMS_SEED_PASSWORD blank.
#   EMAIL_TRANSPORT not mock | nic.
#   MAILBOX_SOURCE not auto | nic.
#   IPC_QUERY_EMAIL blank.
#   EMAIL_TRANSPORT=nic or MAILBOX_SOURCE=nic with any NIC_* IMAP/SMTP setting
#     missing — nicConfig.js owns that list.
#   NIC_BROWSER_MAILBOX=true with NIC_EMAIL blank, or equal to
#     FRONT_OFFICE_EMAIL.
#   NIC_BROWSER_MAILBOX=true, NIC_ALLOW_OUTBOUND not true, and both
#     NIC_BROWSER_TEST_RECIPIENT and NIC_TEST_RECIPIENT blank.
#   NIC_ALLOW_INTERNAL_FORWARD=true with OFFICER_IN_CHARGE_EMAIL blank or
#     ending @example.com.
#
# ADDITIONALLY when NODE_ENV=production:
#
#   EMAIL_TRANSPORT=mock — it records sends that never happened.
#   Neither real channel selected: EMAIL_TRANSPORT is not nic AND
#     NIC_BROWSER_MAILBOX is not true.
#   FRONT_OFFICE_EMAIL or OFFICER_IN_CHARGE_EMAIL blank or ending
#     @example.com.
#
# Also production-only, and not a boot refusal but a 409 at the endpoint:
# POST /mailbox/receive and DELETE /mailbox are test fixtures and refuse to run.
# POST /queries/reset does NOT yet refuse, and it deletes every case.
# ─────────────────────────────────────────────────────────────────────────────
