PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=mongodb://127.0.0.1:27017/query_management_system

# Hosted MongoDB (Atlas). Provision the cluster's structure — collections and
# indexes, no cases — with `npm run db:provision`, then move that same URI onto
# DATABASE_URL above to run the backend against it. The URI must name the
# database, or everything lands in `test`.
# ATLAS_DATABASE_URL=mongodb+srv://qms_app:<password>@cluster0.xxxxx.mongodb.net/query_management_system?retryWrites=true&w=majority
JWT_SECRET=change-me-to-at-least-32-characters-long

# ── Sign-in credentials ──────────────────────────────────────────────────────
# Each account has its OWN password. There used to be one shared secret here
# that opened every account: login compared the submitted password against a
# single hash that did not depend on which account the address named, so anyone
# holding any account could sign in as SUPER_ADMIN with their own password.
#
# Two sources, in order of preference, per account:
#
#   1. QMS_PASSWORDS_FILE — a path to a JSON file OUTSIDE the repository:
#        { "USR-0001": "...", "USR-0002": "...", ... }
#      This is the production form, because config then stores a path rather
#      than a set of secrets. Keep it 0600.
#   2. QMS_PASSWORD_<USER_ID> — the value itself, e.g. QMS_PASSWORD_USR_0008.
#      Simpler for development; the secret then lives in backend/.env, which is
#      gitignored. The user ids are listed in src/constants/users.js.
#
# The server refuses to start if any seeded account has neither. That is
# deliberate: a missing credential should be a named boot failure, not a person
# who cannot sign in and is told only "Invalid email or password".
QMS_PASSWORDS_FILE=

# The legacy behaviour, off by default: with this set to the exact string
# "true", any account without its own credential falls back to
# QMS_SEED_PASSWORD. That is one secret opening every account, SUPER_ADMIN
# included. It exists so an existing deployment does not lock itself out on
# upgrade. Turn it off as soon as per-account credentials are in place.
QMS_ALLOW_SHARED_PASSWORD=false
QMS_SEED_PASSWORD=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=qms.session
SESSION_COOKIE_SAMESITE=lax

# ── Email transport ──────────────────────────────────────────────────────────
# mock  = nothing leaves the machine (default, and what tests always use)
# gmail = real sends through each stakeholder's own Gmail account
# nic   = NICeMail SMTP, one shared government mailbox (see the NICeMail block).
#         Also requires NIC_ALLOW_OUTBOUND=true before it will mail anyone
#         other than NIC_TEST_RECIPIENT.
EMAIL_TRANSPORT=mock

# Where incoming enquiries are read from.
# auto  = MongoDB when connected, else in-memory (the mock mailbox)
# gmail = poll the Front Officer's real Gmail inbox
# nic   = poll the NICeMail mailbox over IMAP, read-only
MAILBOX_SOURCE=auto

# ── Stakeholder identities ───────────────────────────────────────────────────
# Nothing here is secret. Leaving one blank falls back to an `@example.com`
# placeholder that cannot receive mail — deliberately, so a missing value fails
# visibly instead of quietly mailing whoever the default used to name.
#
# REQUIRED — the Front Office mailbox. Enquiries must be addressed to it to be
# picked up, every outbound message is sent from it, and it is the account
# GMAIL_REFRESH_TOKEN_FRONT_OFFICE authenticates.
FRONT_OFFICE_NAME=
FRONT_OFFICE_EMAIL=

# REQUIRED — where the Front Officer forwards a validated case. A recipient
# address only; nothing authenticates or sends as this role.
OFFICER_IN_CHARGE_NAME=
OFFICER_IN_CHARGE_EMAIL=

# OPTIONAL, and not part of the intake path. An inquirer is whoever sent the
# incoming mail — their name and address are read off the message and stored on
# the case, so there is no single configured inquirer. These two only label the
# in-app "Raise Enquiry" test harness, which sends through the mock transport.
INQUIRER_NAME=
INQUIRER_EMAIL=


# Shared mock mailbox address, used when no real stakeholder is configured.
IPC_QUERY_EMAIL=ipc-query-mock@example.com
IPC_ACK_FROM_EMAIL=arnd-ipc-mock@example.com
IPC_ACK_FROM_NAME=AR&D Division

# ── Gmail OAuth ──────────────────────────────────────────────────────────────
# NEVER commit real values. backend/.env is gitignored; keep it that way.
#
# One OAuth application is shared by all accounts:
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# ONE mailbox is authenticated: the Front Office. It is the only account the
# system reads from and the only one it sends as — acknowledgements, the forward
# to the Officer-in-Charge and the final dispatch all go out as the Front
# Officer. REQUIRED when EMAIL_TRANSPORT=gmail; the server will not start
# without it.
#
# Needs BOTH gmail.send and a read scope (gmail.readonly or gmail.modify) —
# the read scope is what polls the inbox when MAILBOX_SOURCE=gmail.
GMAIL_REFRESH_TOKEN_FRONT_OFFICE=

# There is deliberately no GMAIL_REFRESH_TOKEN_INQUIRER and no
# GMAIL_REFRESH_TOKEN_OFFICER_IN_CHARGE.
#
#   Inquirers are EXTERNAL. Anyone can send an enquiry to the Front Office
#   mailbox from their own mail client; they hold no account here and
#   authenticate to nothing. The sender's address is read off the incoming
#   message and stored on the case.
#
#   The Officer-in-Charge is a RECIPIENT, not a sender. Nothing in the codebase
#   ever sends as that role — the forward is addressed to
#   OFFICER_IN_CHARGE_EMAIL and sent as the Front Officer.
#
# If either variable is still present in your .env, delete it: `npm run
# gmail:preflight` will report it as configured-but-unused.

# ── NICeMail — mechanism 1 of 2: IMAP/SMTP ───────────────────────────────────
# The direct mail-protocol integration. These variables power three things:
#   - EMAIL_TRANSPORT=nic and MAILBOX_SOURCE=nic (the production mail path)
#   - `npm run nic:verify` and `npm run nic:preflight`
#   - POST /api/v1/nic/{read,send}
#
# They have NOTHING to do with the NICeMail browser agent, which is mechanism 2
# and is configured in the NIC_CDP_* / NIC_WEBMAIL_* / NIC_BROWSER_* block far
# below. The two never share a credential and never share a code path.
#
# Change this one variable to move to the production mailbox (lab.ipc@gov.in).
# The address is not hardcoded anywhere in the source.
NIC_EMAIL=contact.ecoclubs-edu@gov.in

# The application-specific password from webmail -> Security -> App Passwords.
# NOT the webmail login password: under MFA that is rejected for IMAP/SMTP by
# design. Prefer NIC_APP_PASSWORD_FILE (a path to a 0600 file OUTSIDE the
# repo); NIC_APP_PASSWORD is the development fallback. Never commit either.
NIC_APP_PASSWORD=
NIC_APP_PASSWORD_FILE=

# Endpoints confirmed reachable during Phase 0 (docs/NIC_EMAIL_PHASE0.md).
# imap/smtp.mail.gov.in did NOT answer from outside NICNET.
NIC_IMAP_HOST=imap.mgovcloud.in
NIC_IMAP_PORT=993
NIC_SMTP_HOST=smtp.mgovcloud.in
NIC_SMTP_PORT=465

# Implicit TLS on both ports. Set to the literal "false" only against a server
# that genuinely does not offer it — there is no certificate-validation escape
# hatch anywhere in this codebase, and there should not be one.
NIC_IMAP_SECURE=true
NIC_SMTP_SECURE=true

NIC_MAILBOX=INBOX
# The ONLY address send_nicemail will mail. Defaults to the mailbox itself, so
# the test never reaches a third party.
NIC_TEST_RECIPIENT=contact.ecoclubs-edu@gov.in
NIC_TIMEOUT_MS=20000

# The second key of a two-key interlock on an official government mailbox.
# With EMAIL_TRANSPORT=nic, outbound mail stays confined to NIC_TEST_RECIPIENT
# until this is the exact string "true". Selecting the transport by itself must
# not be enough to start mailing the public from a .gov.in address.
NIC_ALLOW_OUTBOUND=false

# ── NICeMail — mechanism 2 of 2: browser agent over CDP ──────────────────────
# Entirely separate from the IMAP/SMTP block above. The agent attaches to a
# Chrome session the OPERATOR has already opened and signed in to by hand; it
# never launches a browser, never navigates to a login page, never types a
# credential and never touches an OTP field. There is deliberately no password
# here, and there must never be one.
#
# Operator prerequisite (nothing the application can do for you):
#   chrome.exe --remote-debugging-port=9222 --user-data-dir=C:\qms-chrome
#   (a non-default user-data-dir is required on Chrome 136+), then sign in to
#   NICeMail in that window. Verify with `npm run nic:browser:discover`.
#
# Note the port must be FREE: another Chromium browser (Brave, Edge, a second
# Chrome profile) holding 9222 will answer the connection without speaking CDP.
NIC_CDP_ENDPOINT=http://localhost:9222
# Comma-separated. How a NICeMail tab is recognised among everything else open.
NIC_WEBMAIL_URL_PATTERNS=mail.gov.in,mgovcloud.in
NIC_WEBMAIL_TITLE_PATTERNS=mail,inbox,nic
# The URL the agent opens in its OWN background tab — never the operator's tab.
# On the workplace front door the mail UI is a cross-origin iframe with a
# debugging target of its own, which one session cannot drive; this address
# serves the same mailbox as a single top-level document, in the same profile
# and so with the same sign-in.
NIC_WEBMAIL_APP_URL=https://mail.mgovcloud.in/zm/
# Falls back to NIC_TEST_RECIPIENT, then NIC_EMAIL.
NIC_BROWSER_TEST_RECIPIENT=
NIC_BROWSER_TIMEOUT_MS=20000
# Where `npm run nic:browser:discover -- --json` writes its inspection reports.
# Relative paths resolve to the backend package root.
NIC_BROWSER_ARTIFACT_DIR=storage/nic-browser

# The NICeMail mailbox as a SECOND Front Office mailbox, read by the browser
# agent. "true" adds a Front Office account that signs in as NIC_EMAIL (with
# QMS_SEED_PASSWORD) and sees only that mailbox; the FRONT_OFFICE_* account
# keeps the MAILBOX_SOURCE mailbox. Requires MongoDB, and NIC_EMAIL must differ
# from FRONT_OFFICE_EMAIL. The IMAP settings above are NOT needed for this.
#
# Cases accepted from this mailbox send their acknowledgement and final
# response through the signed-in NICeMail browser session, confined to
# NIC_BROWSER_TEST_RECIPIENT until NIC_ALLOW_OUTBOUND=true. The forward to the
# Officer-in-Charge stays on EMAIL_TRANSPORT.
NIC_BROWSER_MAILBOX=false
# The display name of that second Front Office — on its sign-in account and on
# the From line of mail it sends (e.g. "Eco-Clubs Front Office"). A name, not
# an address. Empty falls back to "NICeMail Front Office".
NIC_FRONT_OFFICE_NAME=

# The inbox poll triggers a sync at most this often; each sync opens at most
# NIC_BROWSER_SYNC_MAX new messages.
NIC_BROWSER_SYNC_TTL_MS=30000
NIC_BROWSER_SYNC_MAX=20

# --- Pravah Gemma LLM ---------------------------------------------------
# Full endpoint URL for the Pravah Gemma model. Leave EMPTY to disable the
# LLM entirely — every AI call then returns its deterministic fallback.
GEMMA_API_URL=https://pravahai.aicte-india.org/llm/api/gemma
# Base request timeout. Recommendations multiply this by 3. A draft asks each
# question separately and multiplies this by 2 per question call, running at most
# 4 of those at a time.
GEMMA_TIMEOUT_MS=12000

# --- Mailbox junk retention -----------------------------------------------
# Inbound mail is triaged into genuine enquiries and junk: deterministic rules
# on arrival (loop-back from our own addresses, bounces, no-reply senders,
# empty bodies), then one Gemma call for whatever the rules could not settle.
# Junk keeps its content for MAILBOX_RETENTION_HOURS and stays visible in the
# Junk filter, so a Front Officer can rescue anything wrongly judged. After
# that the sweep strips the body, the HTML and the attachment bytes, leaving an
# id stub — the stub is what stops the next sync re-ingesting the message.
#
# Nothing is purged that somebody accepted, that became a Query Case, or that
# somebody rescued. Every purge writes an EMAIL_PURGED audit row naming the
# sender and subject, so what was destroyed is always answerable.
#
# Inspect before trusting it:  npm run mailbox:purge -- --dry-run
MAILBOX_RETENTION_HOURS=46
# `false` disables the hourly sweep entirely. Triage and the Junk filter carry
# on working; nothing is ever destroyed.
MAILBOX_RETENTION_ENABLED=true
# How confident a junk verdict must be before content may go. A deterministic
# rule scores 1; the model is clamped to 0.95 and so can never claim rule-grade
# certainty.
#
# Set this to exactly 1 and only the deterministic rules can purge: model
# verdicts still populate the Junk filter but can never destroy anything. That
# is the kill switch if the classifier misbehaves, and 1 is the exact value —
# ABOVE 1 nothing purges at all, because a hard rule scores 1.
MAILBOX_JUNK_CONFIDENCE=0.9
# Per hourly pass. Modest on purpose: a shared LLM endpoint and a 512MB cluster.
MAILBOX_TRIAGE_BATCH=25
MAILBOX_PURGE_BATCH=50

# --- Attachments ----------------------------------------------------------
# NOTE: the attachment endpoints require a session and a role, but not yet a
# case — any signed-in user can read any attachment by id. See the TODO in
# middleware/authorizeAttachmentAccess.js.
# Directory attachment bytes are written to. A relative value is resolved
# against the backend package root (not the working directory), so this lands in
# backend/storage/attachments however the server was started. Absolute paths are
# used as-is. Defaults to storage/attachments when unset.
ATTACHMENT_DIR=storage/attachments
ATTACHMENT_MAX_FILE_MB=10
# Kept below Gmail's 25MB (encoded) cap: base64 inflates payload size ~33%.
ATTACHMENT_MAX_TOTAL_MB=15
ATTACHMENT_MAX_FILES=10
