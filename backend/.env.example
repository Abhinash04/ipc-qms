PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=mongodb://127.0.0.1:27017/query_management_system

# Hosted MongoDB (Atlas). Provision the cluster's structure — collections and
# indexes, no cases — with `npm run db:provision`, then move that same URI onto
# DATABASE_URL above to run the backend against it. The URI must name the
# database, or everything lands in `test`.
# ATLAS_DATABASE_URL=mongodb+srv://qms_app:<password>@cluster0.xxxxx.mongodb.net/query_management_system?retryWrites=true&w=majority
JWT_SECRET=change-me-to-at-least-32-characters-long
QMS_PASSWORDS_FILE=
QMS_ALLOW_SHARED_PASSWORD=false
QMS_SEED_PASSWORD=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=qms.session
SESSION_COOKIE_SAMESITE=lax

# EMAIL_TRANSPORT governs every OTHER case:
#   mock = nothing leaves the machine. Records each send as delivered, which is
#          right for development and catastrophic in production — it would close
#          cases and tell inquirers they had been answered. Refused when
#          NODE_ENV=production.
#   nic  = NICeMail SMTP, the direct mail protocol (see the IMAP/SMTP block).
#          Also held to NIC_TEST_RECIPIENT until NIC_ALLOW_OUTBOUND=true.
EMAIL_TRANSPORT=mock

# Where incoming enquiries are read from. Independent of the browser agent,
# which adds a mailbox of its own alongside whatever this selects.
#   auto = MongoDB when connected, else in-memory. The local test mailbox.
#   nic  = poll the NICeMail mailbox over IMAP, read-only.
MAILBOX_SOURCE=auto
FRONT_OFFICE_NAME=
FRONT_OFFICE_EMAIL=
OFFICER_IN_CHARGE_NAME=
OFFICER_IN_CHARGE_EMAIL=

IPC_QUERY_EMAIL=ipc-query-mock@example.com
IPC_ACK_FROM_EMAIL=arnd-ipc-mock@example.com
IPC_ACK_FROM_NAME=AR&D Division

NIC_EMAIL=contact.ecoclubs-edu@gov.in
NIC_APP_PASSWORD=
NIC_APP_PASSWORD_FILE=
NIC_IMAP_HOST=imap.mgovcloud.in
NIC_IMAP_PORT=993
NIC_SMTP_HOST=smtp.mgovcloud.in
NIC_SMTP_PORT=465
NIC_IMAP_SECURE=true
NIC_SMTP_SECURE=true
NIC_MAILBOX=INBOX
NIC_TEST_RECIPIENT=contact.ecoclubs-edu@gov.in
NIC_TIMEOUT_MS=20000
NIC_ALLOW_OUTBOUND=false
NIC_ALLOW_INTERNAL_FORWARD=false
NIC_CDP_ENDPOINT=http://localhost:9222
NIC_WEBMAIL_URL_PATTERNS=mail.gov.in,mgovcloud.in
NIC_WEBMAIL_TITLE_PATTERNS=mail,inbox,nic
NIC_WEBMAIL_APP_URL=https://mail.mgovcloud.in/zm/
NIC_BROWSER_TEST_RECIPIENT=
NIC_BROWSER_TIMEOUT_MS=20000
NIC_BROWSER_ARTIFACT_DIR=storage/nic-browser
NIC_BROWSER_MAILBOX=false
NIC_FRONT_OFFICE_NAME=
NIC_BROWSER_SYNC_TTL_MS=30000

NIC_BROWSER_SYNC_MAX=20
GEMMA_API_URL=https://pravahai.aicte-india.org/llm/api/gemma
GEMMA_TIMEOUT_MS=12000

# --- Mailbox junk retention -----------------------------------------------
# Inbound mail is triaged into genuine enquiries and junk: deterministic rules
# on arrival (loop-back from our own addresses, bounces, no-reply senders,
# empty bodies), then one Gemma call for whatever the rules could not settle.
# Junk keeps its content for MAILBOX_RETENTION_HOURS and stays visible in the
# Junk filter, so a Front Officer can rescue anything wrongly judged. After
# that the sweep strips the body, the HTML and the attachment bytes, leaving an
# id stub — the stub is what stops the next sync re-ingesting the message.
#
# Nothing is purged that somebody accepted, that became a Query Case, or that
# somebody rescued. Every purge writes an EMAIL_PURGED audit row naming the
# sender and subject, so what was destroyed is always answerable.
#
# Inspect before trusting it:  npm run mailbox:purge -- --dry-run
MAILBOX_RETENTION_HOURS=42
# The second tier, and the one that actually bounds the collection.
#
# The window above only ever reaches mail a rule or the model called junk. A
# genuine enquiry is pinned at confidence 0 and so can never satisfy it at any
# age — without this key an enquiry nobody ever Ticks is kept whole forever.
# This window takes anything still unregistered, whatever its verdict.
#
# Two weeks rather than two days on purpose: a message here is not junk, it is
# work nobody got to, so the margin has to survive leave, a holiday and a
# backlog. Registered mail and rescued mail are exempt, and the same
# EMAIL_PURGED audit row records what went.
#
# Must not be shorter than MAILBOX_RETENTION_HOURS — the server refuses to boot
# if it is, because the age rule would then fire first and the confidence floor
# above would never be consulted.
MAILBOX_UNREGISTERED_RETENTION_HOURS=336
# `false` disables the hourly sweep entirely. Triage and the Junk filter carry
# on working; nothing is ever destroyed.
MAILBOX_RETENTION_ENABLED=true
# How confident a junk verdict must be before content may go. A deterministic
# rule scores 1; the model is clamped to 0.95 and so can never claim rule-grade
# certainty.
#
# Set this to exactly 1 and only the deterministic rules can purge: model
# verdicts still populate the Junk filter but can never destroy anything. That
# is the kill switch if the classifier misbehaves, and 1 is the exact value —
# ABOVE 1 nothing purges at all, because a hard rule scores 1.
MAILBOX_JUNK_CONFIDENCE=0.9
# Per hourly pass. Modest on purpose: a shared LLM endpoint and a 512MB cluster.
MAILBOX_TRIAGE_BATCH=25
MAILBOX_PURGE_BATCH=50

ATTACHMENT_DIR=storage/attachments
ATTACHMENT_MAX_FILE_MB=10
ATTACHMENT_MAX_TOTAL_MB=15
ATTACHMENT_MAX_FILES=10
