PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=mongodb://127.0.0.1:27017/query_management_system

# ── Authentication ───────────────────────────────────────────────────────────
# Signs the session JWT carried in the httpOnly cookie. REQUIRED — the server
# refuses to start without it. Minimum 32 characters; generate a real one with:
#   openssl rand -base64 48
# Never commit the production value.
JWT_SECRET=change-me-to-at-least-32-characters-long

# The sign-in password shared by every seeded account in src/constants/users.js.
# REQUIRED. This is a development seeding mechanism, not a production user
# store — see the TODO in services/auth/userDirectory.js.
QMS_SEED_PASSWORD=change-me

# Session lifetime. A copied token stays valid until it expires: logout clears
# the cookie but cannot revoke the token (tokenService.js).
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=qms.session
# lax is correct when the frontend and API share a registrable domain. Use
# none ONLY for a genuinely cross-site deployment — it forces Secure, so it
# will not work over plain http.
SESSION_COOKIE_SAMESITE=lax

# ── Email transport ──────────────────────────────────────────────────────────
# mock  = nothing leaves the machine (default, and what tests always use)
# gmail = real sends through each stakeholder's own Gmail account
EMAIL_TRANSPORT=mock

# Where incoming enquiries are read from.
# auto  = MongoDB when connected, else in-memory (the mock mailbox)
# gmail = poll the Front Officer's real Gmail inbox
MAILBOX_SOURCE=auto

# ── Stakeholder identities ───────────────────────────────────────────────────
# The user records in the frontend are the source of truth for WHO holds each
# role; these variables only override the address value. Nothing here is secret.
INQUIRER_NAME=Abhinash Pritiraj
INQUIRER_EMAIL=abhinash.pritiraj@gmail.com

FRONT_OFFICE_NAME=Bhumika Makker
FRONT_OFFICE_EMAIL=bhoomikamakker@gmail.com

OFFICER_IN_CHARGE_NAME=Jatin Rawat
OFFICER_IN_CHARGE_EMAIL=rawatjatin436@gmail.com


# Shared mock mailbox address, used when no real stakeholder is configured.
IPC_QUERY_EMAIL=ipc-query-mock@example.com
IPC_ACK_FROM_EMAIL=arnd-ipc-mock@example.com
IPC_ACK_FROM_NAME=AR&D Division

# ── Gmail OAuth ──────────────────────────────────────────────────────────────
# NEVER commit real values. backend/.env is gitignored; keep it that way.
#
# One OAuth application is shared by all accounts:
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# One refresh token PER ACCOUNT. A token authenticates exactly one Gmail
# account, and Gmail sends as that account whatever the From header says — so
# there is no way to send "as Bhumika" using Abhinash's token. Each person must
# authorise their own account. A role left blank falls back to the mock
# transport; no other account is ever used on its behalf.
#
# Only FRONT_OFFICE needs a read scope (gmail.readonly or gmail.modify), and
# only when MAILBOX_SOURCE=gmail — that is what polls her inbox for enquiries.
GMAIL_REFRESH_TOKEN_INQUIRER=
GMAIL_REFRESH_TOKEN_FRONT_OFFICE=
GMAIL_REFRESH_TOKEN_OFFICER_IN_CHARGE=

# --- NICeMail (read/send verification) ------------------------------------
# Standalone capability: NIC is NOT a selectable EMAIL_TRANSPORT. These only
# power `npm run nic:verify` and POST /api/v1/nic/{read,send}.
NIC_EMAIL=contact.ecoclubs-edu@gov.in

# The application-specific password from webmail -> Security -> App Passwords.
# NOT the webmail login password: under MFA that is rejected for IMAP/SMTP by
# design. Prefer NIC_APP_PASSWORD_FILE (a path to a 0600 file OUTSIDE the
# repo); NIC_APP_PASSWORD is the development fallback. Never commit either.
NIC_APP_PASSWORD=
NIC_APP_PASSWORD_FILE=

# Endpoints confirmed reachable during Phase 0 (docs/NIC_EMAIL_PHASE0.md).
# imap/smtp.mail.gov.in did NOT answer from outside NICNET.
NIC_IMAP_HOST=imap.mgovcloud.in
NIC_IMAP_PORT=993
NIC_SMTP_HOST=smtp.mgovcloud.in
NIC_SMTP_PORT=465

NIC_MAILBOX=INBOX
# The ONLY address send_nicemail will mail. Defaults to the mailbox itself, so
# the test never reaches a third party.
NIC_TEST_RECIPIENT=contact.ecoclubs-edu@gov.in
NIC_TIMEOUT_MS=20000

# --- Pravah Gemma LLM ---------------------------------------------------
# Full endpoint URL for the Pravah Gemma model. Leave EMPTY to disable the
# LLM entirely — every AI call then returns its deterministic fallback.
GEMMA_API_URL=https://pravahai.aicte-india.org/llm/api/gemma
# Base request timeout. Recommendations and drafts multiply this by 3.
GEMMA_TIMEOUT_MS=12000

# --- Attachments ----------------------------------------------------------
# NOTE: the attachment endpoints require a session and a role, but not yet a
# case — any signed-in user can read any attachment by id. See the TODO in
# middleware/authorizeAttachmentAccess.js.
# Directory attachment bytes are written to. Defaults to storage/attachments
# under the backend's working directory.
ATTACHMENT_DIR=backend\storage\attachments
ATTACHMENT_MAX_FILE_MB=10
# Kept below Gmail's 25MB (encoded) cap: base64 inflates payload size ~33%.
ATTACHMENT_MAX_TOTAL_MB=15
ATTACHMENT_MAX_FILES=10
