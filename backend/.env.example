PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=mongodb://127.0.0.1:27017/query_management_system

# ── Email transport ──────────────────────────────────────────────────────────
# mock  = nothing leaves the machine (default, and what tests always use)
# gmail = real sends through each stakeholder's own Gmail account
EMAIL_TRANSPORT=mock

# Where incoming enquiries are read from.
# auto  = MongoDB when connected, else in-memory (the mock mailbox)
# gmail = poll the Front Officer's real Gmail inbox
MAILBOX_SOURCE=auto

# ── Stakeholder identities ───────────────────────────────────────────────────
# The user records in the frontend are the source of truth for WHO holds each
# role; these variables only override the address value. Nothing here is secret.
INQUIRER_NAME=Abhinash Pritiraj
INQUIRER_EMAIL=abhinash.pritiraj@gmail.com

FRONT_OFFICE_NAME=Bhumika Makker
FRONT_OFFICE_EMAIL=bhoomikamakker@gmail.com

OFFICER_IN_CHARGE_NAME=Jatin Rawat
OFFICER_IN_CHARGE_EMAIL=rawatjatin436@gmail.com

ASSIGNED_OFFICIAL_NAME=Rawat Jatin
ASSIGNED_OFFICIAL_EMAIL=jatinrawat55361@gmail.com

# Shared mock mailbox address, used when no real stakeholder is configured.
IPC_QUERY_EMAIL=ipc-query-mock@example.com
IPC_ACK_FROM_EMAIL=arnd-ipc-mock@example.com
IPC_ACK_FROM_NAME=AR&D Division

# ── Gmail OAuth ──────────────────────────────────────────────────────────────
# NEVER commit real values. backend/.env is gitignored; keep it that way.
#
# One OAuth application is shared by all accounts:
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# One refresh token PER ACCOUNT. A token authenticates exactly one Gmail
# account, and Gmail sends as that account whatever the From header says — so
# there is no way to send "as Bhumika" using Abhinash's token. Each person must
# authorise their own account. A role left blank falls back to the mock
# transport; no other account is ever used on its behalf.
#
# Only FRONT_OFFICE needs a read scope (gmail.readonly or gmail.modify), and
# only when MAILBOX_SOURCE=gmail — that is what polls her inbox for enquiries.
GMAIL_REFRESH_TOKEN_INQUIRER=
GMAIL_REFRESH_TOKEN_FRONT_OFFICE=
GMAIL_REFRESH_TOKEN_OFFICER_IN_CHARGE=
GMAIL_REFRESH_TOKEN_ASSIGNED_OFFICIAL=
