# The end-to-end suite's backend settings. TRACKED — no secrets here, ever.
#
# Loaded by `ENV_FILE=.env.e2e`, which frontend/playwright.config.js sets on the
# backend it starts. config/env.js reads this file BEFORE `.env`, and dotenv
# never overwrites a variable that is already set, so every key below wins.
#
# The rule that matters: a key this file OMITS is inherited from the developer's
# own `.env`. That is how a test run could reach a live mailbox — the file used
# to select a real mail provider and name no NIC_* variable at all, so whatever
# was in `.env` applied. Every mail variable is therefore pinned below, most of
# them to an empty value, which counts as set. Follow backend/vitest.config.mjs,
# which pins the same list for the unit suite.
#
# Inherited from `.env` on purpose: JWT_SECRET. It is a real secret and belongs
# in a gitignored file, and the server cannot boot without one anyway.

NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/qms_e2e

# ── Credentials ──────────────────────────────────────────────────────────────
# One distinct password per account, from the fixture the unit suite already
# uses. The shared-password mode is pinned OFF: unset, it would switch itself ON
# here, because NODE_ENV is development and `.env` sets QMS_SEED_PASSWORD.
#
# The path is relative, so it resolves for a server hand-started from backend/.
# playwright.config.js passes an ABSOLUTE path in the environment — which wins,
# being already set — because the test process runs from frontend/ and reads the
# same file to sign in with.
QMS_PASSWORDS_FILE=src/test/fixtures/passwords.json
QMS_ALLOW_SHARED_PASSWORD=false
QMS_SEED_PASSWORD=

# ── Mail: nothing may leave this machine ─────────────────────────────────────
# The suite injects inbound mail through POST /mailbox/receive and asserts on
# what the mock transport records. No real channel is selected, and no real
# mailbox is configured to select one with.
EMAIL_TRANSPORT=mock
MAILBOX_SOURCE=auto

# `.invalid` is reserved by RFC 2606 and can never resolve, so a send that
# somehow escaped the mock fails at DNS rather than reaching a person.
FRONT_OFFICE_NAME=E2E Front Officer
FRONT_OFFICE_EMAIL=front-office@e2e.invalid
OFFICER_IN_CHARGE_NAME=E2E Officer-in-Charge
OFFICER_IN_CHARGE_EMAIL=officer@e2e.invalid
IPC_QUERY_EMAIL=ipc-query@e2e.invalid
IPC_ACK_FROM_EMAIL=arnd@e2e.invalid
IPC_ACK_FROM_NAME=AR&D Division

# ── NICeMail: every variable pinned, so none is inherited ────────────────────
# Blank credentials and hosts mean an un-stubbed NICeMail action fails at the
# config stage instead of opening a socket to a real government mailbox.
NIC_EMAIL=
NIC_APP_PASSWORD=
NIC_APP_PASSWORD_FILE=
NIC_IMAP_HOST=
NIC_SMTP_HOST=
NIC_TEST_RECIPIENT=
NIC_MAILBOX=
NIC_TIMEOUT_MS=
# The browser agent, pinned off. Unroutable endpoint as well as the off switch:
# an un-stubbed attach must fail instantly, never reach a real Chrome on the
# developer's machine.
NIC_BROWSER_MAILBOX=
NIC_CDP_ENDPOINT=http://127.0.0.1:1
NIC_FRONT_OFFICE_NAME=
NIC_BROWSER_TEST_RECIPIENT=
NIC_BROWSER_TIMEOUT_MS=
NIC_BROWSER_SYNC_TTL_MS=
NIC_BROWSER_SYNC_MAX=
NIC_BROWSER_ARTIFACT_DIR=
NIC_WEBMAIL_URL_PATTERNS=
NIC_WEBMAIL_TITLE_PATTERNS=
NIC_WEBMAIL_APP_URL=
# Both interlock keys pinned to their safe default: a developer who has opened
# real outbound mail locally must not run this suite with the guard switched off.
NIC_ALLOW_OUTBOUND=
NIC_ALLOW_INTERNAL_FORWARD=

# ── AI: no network ───────────────────────────────────────────────────────────
# Blank short-circuits gemmaService to its deterministic fallback before any
# fetch. It also keeps the suite's timing predictable, since a live summary is
# ~5s and intake waits for one.
GEMMA_API_URL=
GEMMA_TIMEOUT_MS=12000

# ── Isolation from the developer's own store ──────────────────────────────────
# Pinned so a suite run cannot write its cases' attachments into the development
# store, and so CORS matches the origin playwright.config.js forces Vite onto
# with --strictPort. Both were inherited from `.env` before.
CLIENT_URL=http://localhost:5173
ATTACHMENT_DIR=storage/e2e-attachments
